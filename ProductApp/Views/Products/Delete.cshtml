@model ProductApp.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewData["ErrorMessage"]
    </div>
}

<div class="container mt-4" style="max-width:500px;">
    <h2>Delete Product</h2>
    <hr />

    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete <strong>@Model.Name</strong>?
        This will also delete the product image.
    </div>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="/images/products/@Model.ImagePath"
             alt="Image of @Model.Name"
             style="max-height:200px; border-radius:8px; margin-bottom:15px;" />
    }

    <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" aria-label="Confirm delete product">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>